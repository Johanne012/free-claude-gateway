# ======================
# Free Claude Gateway
# ======================

# Server
HOST=127.0.0.1
PORT=8082
AUTH_TOKEN=fcc                 # Optional. Leave empty to disable auth.

# ======================
# Model Routing
# Format: provider/model-id
# ======================
MODEL_OPUS=openrouter/deepseek/deepseek-chat:free
MODEL_SONNET=openrouter/deepseek/deepseek-chat:free
MODEL_HAIKU=ollama/llama3.2
MODEL_FALLBACK=nvidia_nim/nvidia/nemotron

# Comma-separated fallback chain (tried in order when primary fails)
FALLBACK_CHAIN=openrouter/deepseek/deepseek-chat:free,deepseek/deepseek-chat,ollama/llama3.2

# ======================
# Provider API Keys
# ======================
NVIDIA_NIM_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
GROQ_API_KEY=

# Local providers (no key needed)
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234
