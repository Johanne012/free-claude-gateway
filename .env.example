# ======================
# Free Claude Gateway
# ======================

# Server
HOST=127.0.0.1
PORT=8082
AUTH_TOKEN=fcc                 # Optional. Leave empty to disable auth.

# ======================
# Model Routing (primary per Claude tier)
# Format: provider/model-id
# ======================
MODEL_OPUS=openrouter/deepseek/deepseek-chat:free
MODEL_SONNET=openrouter/deepseek/deepseek-chat:free
MODEL_HAIKU=ollama/llama3.2
MODEL_FALLBACK=nvidia_nim/nvidia/nemotron

# ======================
# Balancing Strategy
# Options: priority | round_robin | random | weighted
# ======================
BALANCE_STRATEGY=priority

# Fallback / balance chain
# - priority     → try in this exact order
# - round_robin  → rotate evenly across the list
# - random       → pick randomly
# - weighted     → use weights after the model (e.g. :3 means weight 3)
#
# Examples:
#   priority / round_robin / random:
#     openrouter/deepseek/deepseek-chat:free,deepseek/deepseek-chat,kimi/kimi-k2.5,ollama/llama3.2
#
#   weighted:
#     openrouter/deepseek/deepseek-chat:free:3,deepseek/deepseek-chat:2,kimi/kimi-k2.5:2,ollama/llama3.2:1
FALLBACK_CHAIN=openrouter/deepseek/deepseek-chat:free,deepseek/deepseek-chat,kimi/kimi-k2.5,ollama/llama3.2

# ======================
# Provider API Keys
# ======================
NVIDIA_NIM_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
GROQ_API_KEY=

# Local providers (no key needed)
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234
